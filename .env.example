# LLM（DeepSeek，OpenAI 兼容；rag/llm.py 强制 model_provider=openai）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的DeepSeek密钥
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0

# Milvus
MILVUS_URL=http://localhost:19530
DB_NAME=
COL_NAME=docs
# 分区模式：指向 knowledge_partitions.json 后，入库/检索走分区库
# medical_knowledge_base（用 `python -m scripts.ingest_partitioned` 入库）；
# 置空 / none / off 则回退平铺 docs / RAG_DOCS（用 `python -m scripts.ingest`）。
PARTITION_CONFIG=knowledge_partitions.json

# Embedding
EMBED_MODEL_NAME=qwen3.7-text-embedding-flash
DASHSCOPE_API_KEY=your_dashscope_api_key
EMBED_DIMENSION=1024
EMBED_BATCH_SIZE=20

# MinerU document parsing
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_OUTPUT_DIR=data/parsed/mineru

# PostgreSQL checkpoint（本地运行时连 localhost；Docker 会把 5432 映射到本机）
POSTGRES_URI=postgresql://self_rag:self_rag@localhost:5432/self_rag?sslmode=disable
RAG_DEFAULT_THREAD_ID=default

# 用户登录鉴权（多用户区分，为 Mem0 铺路）
# AUTH_TOKEN_SECRET 留空则用进程内随机密钥（重启后已签发 token 失效）；生产请设置固定值
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=24

# Mem0 长期记忆（跨会话，按 user 隔离；复用上方 LLM/EMBED/MILVUS）
# 默认关闭；开启前确认:已装 mem0ai、Milvus 里该 collection 能建(维度须等于 EMBED_DIMENSION)
MEM0_ENABLED=false
MEM0_COLLECTION_NAME=mem0_memories
MEM0_TOP_K=3
# mem0 会额外用一个本地 sqlite 记自己的 history，放进 data/mem0 而不是项目根
MEM0_HISTORY_DB_PATH=data/mem0/history.db
# 留空用 Milvus default DB；如要与知识库同库分 collection 可保持空
# MEM0_MILVUS_DB_NAME=

# Docker Compose 基础设施默认凭据（与上面 POSTGRES_URI 保持一致）
# 仅用于 docker-compose.yml 中的 postgres / minio 容器，本地 Python 不用读
POSTGRES_USER=self_rag
POSTGRES_PASSWORD=self_rag
POSTGRES_DB=self_rag
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 联网检索兜底(可选):本地知识库判为不相关且重写耗尽后,降级检索一次
# TAVILY_API_KEY=your_tavily_api_key
# 可选:逗号分隔的可信域名白名单(医疗场景建议只放药监/卫健委/医院官网),留空不限
# TAVILY_ALLOWED_DOMAINS=

# RAG
KNOWLEDGE_FILE=data/raw/customer_service_knowledge_base.txt
RAG_TOP_K=3
RAG_MAX_RETRIES=3
RAG_RELEVANCE_THRESHOLD=0.5
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=80
