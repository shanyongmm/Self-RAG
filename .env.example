# LLM
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_chat_model
LLM_TEMPERATURE=0

# Milvus
MILVUS_URL=http://localhost:19530
DB_NAME=
COL_NAME=docs

# Embedding
EMBED_MODEL_NAME=your_embedding_model
DASHSCOPE_API_KEY=your_dashscope_api_key
EMBED_DIMENSION=1024
EMBED_BATCH_SIZE=20

# PostgreSQL checkpoint
POSTGRES_URI=postgresql://localhost:5432/self_rag?sslmode=disable
RAG_DEFAULT_THREAD_ID=default

# Docker Compose defaults
POSTGRES_USER=self_rag
POSTGRES_PASSWORD=self_rag
POSTGRES_DB=self_rag
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
AUTO_INGEST=true

# RAG
KNOWLEDGE_FILE=data/raw/customer_service_knowledge_base.txt
RAG_TOP_K=3
RAG_MAX_RETRIES=3
RAG_RELEVANCE_THRESHOLD=0.5
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=80
